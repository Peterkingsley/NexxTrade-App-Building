# Application Environment
NODE_ENV=development

# Database Connection
# Format: postgres://user:password@host:port/database
# Example (Local): postgres://postgres:password@localhost:5432/nexxtrade
# Example (Cloud): postgres://user:pass@ep-random-123.us-east-2.aws.neon.tech/neondb
DATABASE_URL=

# Authentication Keys
# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Telegram Bot Token (for backend verification)
TELEGRAM_BOT_TOKEN=

# API Keys
# Gemini API Key for AI features
API_KEY=